# ==============================================================
# HƯỚNG DẪN: COPY FILE NÀY THÀNH `.env` VÀ ĐIỀN CÁC THÔNG SỐ
# ==============================================================

# ---------------- Server App Configuration ----------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---------------- Ports cho Microservices ----------------
KHO_PORT=3001
USER_SERVICE_PORT=3002
APPROVAL_PORT=3003
LEAVE_REQUEST_PORT=3004

# ---------------- Database (MongoDB) ----------------
# URL kết nối tới MongoDB của bạn (Local hoặc Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/leave-request

# ---------------- Security & Auth (JWT) ----------------
# Hãy đổi sang một chuỗi ngẫu nhiên bí mật trước khi deploy
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN_ACCESS=3600
JWT_EXPIRES_IN_REFRESH=86400
ENCODE_PASSWORD=10

# ---------------- Redis Configuration ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_KEY_PREFIX=leaverequest:
REDIS_TLS=false

# ---------------- NATS Event Bus ----------------
# Nếu dùng docker/local thì để mặc định
NATS_URL=nats://localhost:4222
